{
  "name": "ritmo-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ritmo/web",
    "dev:web": "npm run dev --workspace @ritmo/web",
    "dev:mobile": "npm run start --workspace @ritmo/mobile",
    "build": "npm run build --workspace @ritmo/web",
    "lint": "npm run lint --workspace @ritmo/web && npm run lint --workspace @ritmo/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "next": "16.3.8"
  }
}
